{
	"appId": "com.ahmed-gamal.hms",
	"files": [
		"build/**/*",
		"!build/app/**/*"
	],
	"extraResources": [
		"dist-electron/electron/preload.cjs",
		"dist-electron/electron/views/**/*",
		"dist-electron/electron/utils/**/*",
		"src/electron/assets/**/*",
		"src/app/assets/**/*"
	],
	"icon": "./build/electron/assets/desktopIcon.png",
	"mac": {
		"target": "dmg"
	},
	"linux": {
		"target": "AppImage",
		"category": "Utility"
	},
	"win": {
		"target": [
			"msi"
		]
	},
	"msi": {
		"oneClick": false,
		"perMachine": true
	}
}