{
	"name": "hms",
	"private": true,
	"version": "0.2.7",
	"type": "module",
	"main": "./dist-electron/electron/main.js",
	"author": "Ahmed G. Mohamed",
	"scripts": {
		"test": "jasmine",
		"dev:e": "electron .",
		"dev:te": "npm run build & electron .",
		"build": "tsc --project ./src/electron/tsconfig.json & npm run copyDist",
		"build:t": "npm run build & npm test",
		"copyDist": "copyfiles -u 3 ./src/electron/assets/**/* ./dist-electron/electron/assets && copyfiles -e \"./**/*.ts\" -u 3 ./src/app/views/**/* ./dist-electron/app/views && copyfiles -u 3 ./src/app/assets/**/* ./dist-electron/app/assets",
		"lint": "eslint .",
		"dist": "npm run build & electron-builder --win --x64",
		"check-i18n": "node src/app/check-i18n-keys.js"
	},
	"dependencies": {
		"@digicole/pdfmake-rtl": "^1.2.0",
		"@popperjs/core": "^2.11.8",
		"bcryptjs": "^3.0.2",
		"bootstrap": "^5.3.5",
		"call-bind-apply-helpers": "^1.0.2",
		"chart.js": "^4.4.8",
		"cookie-parser": "^1.4.7",
		"cron": "^4.3.1",
		"dotenv": "^16.4.7",
		"electron-store": "^10.0.1",
		"express": "^5.1.0",
		"jsonwebtoken": "^9.0.2",
		"pdfmake": "^0.2.20",
		"pg": "^8.14.0",
		"sweetalert2": "^11.17.2",
		"toastr": "^2.1.4"
	},
	"devDependencies": {
		"@eslint/js": "^9.21.0",
		"@types/cookie-parser": "^1.4.8",
		"@types/cron": "^2.0.1",
		"@types/express": "^5.0.1",
		"@types/jasmine": "^5.1.7",
		"@types/jasmine-es6-promise-matchers": "^0.0.36",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/pdfmake": "^0.2.11",
		"@types/pg": "^8.11.11",
		"@types/toastr": "^2.1.43",
		"copyfiles": "^2.4.1",
		"electron": "^35.0.2",
		"electron-builder": "^26.0.11",
		"electron-reload": "^2.0.0-alpha.1",
		"eslint": "^9.21.0",
		"globals": "^15.15.0",
		"jasmine": "^5.6.0",
		"jasmine-es6-promise-matchers": "^2.1.2",
		"jasmine-spec-reporter": "^7.0.0",
		"jasmine-ts": "^0.4.0",
