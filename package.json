		"@types/react-dom": "^19.2.3",
		"@types/toastr": "^2.1.43",
		"@vitejs/plugin-react": "^6.0.2",
		"concurrently": "^10.0.3",
		"copyfiles": "^2.4.1",
		"electron": "^42.4.1",
		"electron-builder": "^26.0.11",
		"electron-reload": "^2.0.0-alpha.1",
