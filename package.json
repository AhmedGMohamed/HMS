{
	"name": "HealthCore-HMS",
	"private": true,
	"version": "0.3.42",
	"type": "module",
	"main": "./dist-electron/electron/main.js",
	"author": "Ahmed G. Mohamed",
	"scripts": {
		"test": "jasmine",
		"dev:e": "electron .",
		"dev:te": "npm run build & electron .",
		"dev:server": "nodemon src/app/index.ts",
		"dev:renderer": "vite --config src/renderer/vite.config.ts",
		"build:renderer": "vite build --config src/renderer/vite.config.ts",
		"build": "npm run build:renderer && tsc --project ./src/electron/tsconfig.json & npm run copyDist",
		"build:t": "npm run build & npm test",
		"copyDist": "copyfiles -u 3 ./src/electron/assets/**/* ./dist-electron/electron/assets && copyfiles -u 3 ./src/electron/views/**/*.html ./dist-electron/electron/views && copyfiles -u 3 ./src/electron/views/**/*.css ./dist-electron/electron/views && copyfiles -e \"./**/*.ts\" -u 3 ./src/app/views/**/* ./dist-electron/app/views && copyfiles -u 3 ./src/app/assets/**/* ./dist-electron/app/assets",
		"lint": "eslint .",
		"format": "prettier --write \"**/*.{ts,tsx}\"",
		"typecheck": "tsc --noEmit",
		"dist": "npm run build & electron-builder --win --x64",
		"check-i18n": "node src/app/check-i18n-keys.js"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@digicole/pdfmake-rtl": "^1.2.0",
		"@fontsource-variable/inter": "^5.2.8",
