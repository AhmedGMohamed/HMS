		"react-i18next": "^17.0.8",
		"react-resizable-panels": "^4.11.2",
		"react-router-dom": "^7.18.0",
		"recharts": "^3.8.1",
		"sonner": "^2.0.7",
		"sweetalert2": "^11.17.2",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.1",
		"toastr": "^2.1.4",
		"tw-animate-css": "^1.4.0",
