{
	"compilerOptions": {
		"strict": false,
		"target": "ES2020",
		"lib": [
			"ES2020",
			"DOM",
			"DOM.Iterable"
		],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": ".",
		"outDir": "../../dist-electron/app",
		"skipLibCheck": true,
		"downlevelIteration": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"types": [
			"node"
		]
	},
	"include": [
		"**/*.ts"
	],
	"exclude": [
		"tests"
	]
}
